<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Deliberately minimal. Every permission here is required by a feature the
      user asked for; there is nothing for advertising, analytics or identity.

      Not requested, and worth noting because the vendor app requests most of them:
        READ_PHONE_STATE, ACCESS_FINE_LOCATION, READ_CONTACTS, GET_ACCOUNTS,
        QUERY_ALL_PACKAGES, READ_EXTERNAL_STORAGE.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required to send the UDP broadcast used for LAN camera discovery. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Keeps the stream alive while recording with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Snapshots and recordings are written to the app's own scoped storage, so
         no storage permission is needed on API 26+ for the default location. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".FtycamApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ftycam"
        tools:targetApi="34"><!--
          Cleartext is required: the camera transport is a proprietary UDP protocol
          on the local network, not HTTPS. It is scoped to private address ranges
          only — see res/xml/network_security_config.xml.
        -->

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ftycam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".stream.StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
